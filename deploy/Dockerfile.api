FROM golang:1.26.5-alpine AS build

ARG BOOKBOX_VERSION=1.0.0

WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags="-s -w -X main.version=${BOOKBOX_VERSION}" \
      -o /out/bookbox-api ./cmd/api \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/bookbox-admin ./cmd/bookbox-admin

FROM alpine:3.22

RUN apk add --no-cache ca-certificates openssl \
    && addgroup -S -g 10001 bookbox \
    && adduser -S -D -H -u 10001 -G bookbox bookbox \
    && mkdir -p /var/lib/bookbox/tls /run/bookbox-secrets \
    && touch /var/lib/bookbox/.volume-initialized \
    && chown -R 10001:10001 /var/lib/bookbox /run/bookbox-secrets \
    && chmod 0700 /var/lib/bookbox /var/lib/bookbox/tls /run/bookbox-secrets \
    && chmod 0600 /var/lib/bookbox/.volume-initialized

COPY --from=build /out/bookbox-api /usr/local/bin/bookbox-api
COPY --from=build /out/bookbox-admin /usr/local/bin/bookbox-admin
COPY --chmod=0555 deploy/entrypoint-api.sh /usr/local/bin/entrypoint-api.sh

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/entrypoint-api.sh"]
