FROM golang:1.26.5-alpine AS build

WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/netstorage-api ./cmd/api \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/netstorage-admin ./cmd/netstorage-admin

FROM alpine:3.22

RUN apk add --no-cache ca-certificates openssl \
    && addgroup -S -g 10001 netstorage \
    && adduser -S -D -H -u 10001 -G netstorage netstorage \
    && mkdir -p /var/lib/netstorage/tls /run/netstorage-secrets \
    && touch /var/lib/netstorage/.volume-initialized \
    && chown -R 10001:10001 /var/lib/netstorage /run/netstorage-secrets \
    && chmod 0700 /var/lib/netstorage /var/lib/netstorage/tls /run/netstorage-secrets \
    && chmod 0600 /var/lib/netstorage/.volume-initialized

COPY --from=build /out/netstorage-api /usr/local/bin/netstorage-api
COPY --from=build /out/netstorage-admin /usr/local/bin/netstorage-admin
COPY --chmod=0555 deploy/entrypoint-api.sh /usr/local/bin/entrypoint-api.sh

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/entrypoint-api.sh"]
